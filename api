// api/process.js
export default function handler(req, res) {
  if (req.method === 'POST') {
    const { data } = req.body;

    // මෙතැනට ඔයාගේ බර වැඩ (Heavy processing / Calculations / AST parsing) දාන්න පුළුවන්
    // දැනට උදාහරණයක් ලෙස දත්ත ටික process කරන විදිහ:
    const processedResult = `Processed: ${JSON.stringify(data)} (Executed on Cloud)`;

    return res.status(200).json({ 
      success: true, 
      result: processedResult,
      timestamp: new Date().toISOString()
    });
  } else {
    res.setHeader('Allow', ['POST']);
    res.status(405).end(`Method ${req.method} Not Allowed`);
  }
}
